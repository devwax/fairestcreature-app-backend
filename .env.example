# Staging shop subdomain (no .myshopify.com)
SHOPIFY_SHOP=fairestcreature-staging-gt0n4x79

# Dev Dashboard app credentials (Settings → Credentials)
# Secret looks like shpss_... — exchanged for a 24h Admin token via client_credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# App Proxy HMAC shared secret (usually same value as SHOPIFY_CLIENT_SECRET on Dev Dashboard apps).
# Required when REQUIRE_APP_PROXY=true.
SHOPIFY_API_SECRET=

# Production shop (optional). Same Vercel deployment; HMAC + Admin API pick shop from App Proxy `shop`.
# Do not overwrite the staging vars above — that would break staging App Proxy.
SHOPIFY_PRODUCTION_SHOP=54208e-eb
SHOPIFY_PRODUCTION_CLIENT_ID=
SHOPIFY_PRODUCTION_CLIENT_SECRET=
SHOPIFY_PRODUCTION_API_SECRET=

# true on Vercel (only accept signed App Proxy requests). false for local 127.0.0.1 testing.
REQUIRE_APP_PROXY=false

# Comma-separated browser origins for direct CORS calls (optional when using App Proxy).
CORS_ORIGINS=https://fairestcreature-staging-gt0n4x79.myshopify.com,https://shop.fairestcreature.com,https://54208e-eb.myshopify.com,http://127.0.0.1:9292,http://localhost:9292

PORT=8787
SHOPIFY_API_VERSION=2026-07
